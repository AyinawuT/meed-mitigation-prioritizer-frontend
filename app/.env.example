# Local app port
PORT=8000

# Frontend dev server settings
BASE_PATH=/
VITE_PORT=3000

# Used by the containerized Node/Express proxy runtime, not by `npm run dev`
# frontend development. Keep this on a different port than 8000 to avoid
# accidentally pointing the proxy back at itself when the Node app is running.
HIAP_API_URL=http://localhost:9000

# App runtime
NODE_ENV=development
LOG_LEVEL=info
