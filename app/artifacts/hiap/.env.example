# Soft front-end access gate for the shared preview link.
# Optional: overrides the built-in fallback password at BUILD time (Vite
# inlines it into the bundle). If unset, the app still gates using the
# ACCESS_PASSWORD_FALLBACK constant in src/components/PasswordGate.tsx.
# NOTE: this is client-side only — a first privacy layer, not real security.
VITE_ACCESS_PASSWORD=
